{
  "name": "x402 on Solana – Next.js Starter",
  "description": "A minimal Next.js template demonstrating the x402 '402 Payment Required' flow on Solana. Simple pay-to-unlock functionality, Vercel-ready, and developer friendly.",
  "languages": ["TypeScript", "JavaScript"],
  "frameworks": ["Next.js"],
  "blockchain": ["Solana"],
  "tags": ["x402", "payments", "paywall", "starter", "template", "micropayments", "usdc"],
  "demo_url": "https://x402-template.vercel.app",
  "repository_url": "https://github.com/tobySolutions/templates/tree/feat/add-x402-template",
  "maintainers": [
    {
      "name": "Turbine3 / Kronos Guild",
      "github": "tobySolutions"
    }
  ],
  "minimum_node": "18.x",
  "deployment": {
    "vercel": {
      "env": [
        "NEXT_PUBLIC_TREASURY_ADDRESS",
        "NEXT_PUBLIC_NETWORK",
        "NEXT_PUBLIC_PAYMENT_AMOUNT_USD",
        "NEXT_PUBLIC_RPC_ENDPOINT",
        "NEXT_PUBLIC_USDC_DEVNET_MINT",
        "NEXT_PUBLIC_FACILITATOR_URL"
      ]
    }
  },
  "features": [
    "HTTP 402 Payment Required responses",
    "Solana USDC micropayments",
    "Phantom wallet integration",
    "Automatic payment verification",
    "Session management with cookies",
    "Zero-configuration setup",
    "Type-safe with Zod validation",
    "Modern Gill SDK integration"
  ],
  "prerequisites": [
    "Node.js 18+",
    "Phantom wallet browser extension",
    "SOL on Solana Devnet (for fees)",
    "USDC on Solana Devnet (for payments)"
  ]
}
